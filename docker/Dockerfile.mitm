FROM mitmproxy/mitmproxy:10.3.0

# Minimal probe tool
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /addons
COPY mitm/addons/policy.py /addons/policy.py
COPY mitm/addons/rules.json /addons/rules.json

ENV RULES_FILE=/addons/rules.json \
    RELOAD_SECONDS=5 \
    METRICS_PORT=9090

EXPOSE 8080 8081 9090

# Health: addon http server must respond
HEALTHCHECK --interval=10s --timeout=2s --start-period=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:9090/healthz || exit 1

# Use mitmweb so :8081 UI is available; listen on all for the container health probe
CMD ["mitmweb","--mode","regular","--listen-host","0.0.0.0","--listen-port","8080","--web-host","0.0.0.0","--web-port","8081","-s","/addons/policy.py"]

