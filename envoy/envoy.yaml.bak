# --- INSERT THIS BLOCK ABOVE `envoy.filters.http.router` ---
- name: envoy.filters.http.lua
  typed_config:
    "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
    inline_code: |
      -- Treeline decision counters exported via Envoy Prometheus (/stats?format=prometheus)
      local function sanitize(s)
        if not s or s == "" then return "unspecified" end
        s = string.lower(s):gsub("[^%w_]+","_")
        if #s > 64 then s = string.sub(s, 1, 64) end
        return s
      end

      function envoy_on_response(handle)
        local h = handle:headers()
        local status = tonumber(h:get(":status") or "0")
        local act = (h:get("X-Treeline-Action") or ""):lower()
        local reason = sanitize(h:get("X-Treeline-Reason"))

        if status == 451 or act == "blocked" or act == "block" then
          handle:counter("treeline_block_total"):inc(1)
          handle:counter("treeline_block_total_reason_" .. reason):inc(1)
          return
        end

        if act == "redact" or act == "redacted" then
          handle:counter("treeline_redact_total"):inc(1)
          return
        end

        if act == "observe" then
          handle:counter("treeline_observe_total"):inc(1)
          return
        end

        handle:counter("treeline_allow_total"):inc(1)
      end
# --- END INSERT ---

